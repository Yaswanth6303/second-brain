PORT=4000
# Podman container "mongodb" (mongo:8). Replace <password> with MONGO_INITDB_ROOT_PASSWORD.
MONGO_URI=mongodb://root:<password>@localhost:27017/second-brain?authSource=admin
MONGO_URI_TEST=mongodb://root:<password>@localhost:27017/second-brain-test?authSource=admin
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
